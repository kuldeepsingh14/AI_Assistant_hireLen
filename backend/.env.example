# ---- Copy to .env and fill in. Never commit .env ----

# Free Groq API key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Smaller model for job-description parsing. Has its own rate-limit budget.
GROQ_MODEL_FAST=openai/gpt-oss-20b

# auto | fastembed | lexical
#   auto      -> use fastembed if installed, else lexical BM25
#   fastembed -> force local semantic embeddings (needs requirements-optional.txt)
#   lexical   -> force BM25 only (zero downloads, lowest memory)
EMBEDDER=auto

# Accept any http://localhost:<port> origin (IDE preview panes use a random
# port that changes each session). Set to false in production.
ALLOW_LOCAL_ORIGINS=true

# Comma-separated origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:4300,http://127.0.0.1:4300

# Password that unlocks the owner analytics dashboard (/admin)
ADMIN_TOKEN=change-me

# Whose portfolio is this?
# Pronouns the assistant uses for you: they/them | she/her | he/him
OWNER_PRONOUNS=they/them

OWNER_NAME=
